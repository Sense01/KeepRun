rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      match /friends/{fid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == fid);
      }
    }
    match /requests/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid && request.resource.data.status == 'pending';
      allow read, delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if request.auth != null && resource.data.to == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    match /activities/{uid}/items/{aid} {
      allow read: if request.auth != null && (request.auth.uid == uid || exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
