rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return request.auth != null && request.auth.uid == uid; }
    function canSee(owner) { return signedIn() && (request.auth.uid == owner || exists(/databases/$(database)/documents/users/$(owner)/friends/$(request.auth.uid))); }

    // Perfil: leitura apenas pelo próprio, amigos ou destinatário de pedido de amizade (sem listagem).
    match /users/{uid} {
      allow get: if me(uid)
        || exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))
        || exists(/databases/$(database)/documents/requests/$(uid + '_' + request.auth.uid));
      allow list: if false;
      allow create, update: if me(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'code'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 500
        && request.resource.data.code is string && request.resource.data.code.size() <= 8;
      allow delete: if me(uid);

      match /friends/{fid} {
        allow read: if me(uid);
        allow create, update: if me(uid) && fid != uid
          && (exists(/databases/$(database)/documents/requests/$(uid + '_' + fid))
            || exists(/databases/$(database)/documents/requests/$(fid + '_' + uid))
            || exists(/databases/$(database)/documents/users/$(fid)/friends/$(uid)))
          && request.resource.data.keys().hasOnly(['name', 't'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.t is number;
        allow delete: if me(uid) || me(fid);
      }

      // Notificacoes em tempo real (Spark 100% gratuito: apenas remetentes/amigos autorizados escrevem; so o destinatario le).
      match /notifications/{nid} {
        function validNotif(d) {
          return signedIn() && request.auth.uid != uid
            && d.keys().hasOnly(['type', 'actorId', 'actorName', 'entityType', 'entityId', 'postTitle', 'text', 'count', 'read', 't'])
            && d.actorId == request.auth.uid
            && d.actorName is string && d.actorName.size() > 0 && d.actorName.size() <= 60
            && d.entityType is string && d.entityType.size() <= 20
            && d.entityId is string && d.entityId.matches('[^/]{1,100}')
            && d.postTitle is string && d.postTitle.size() <= 80
            && d.text is string && d.text.size() <= 200
            && d.count == 1 && d.read == false && d.t is number
            && (
              (d.type == 'friend_request' && d.entityType == 'friendship' && d.entityId == request.auth.uid
                && nid == 'req_' + request.auth.uid
                && exists(/databases/$(database)/documents/requests/$(uid + '_' + request.auth.uid)))
              || (d.type == 'friend_accepted' && d.entityType == 'friendship' && d.entityId == request.auth.uid
                && nid == 'acc_' + request.auth.uid
                && (exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(uid))
                  || exists(/databases/$(database)/documents/requests/$(request.auth.uid + '_' + uid))))
              || (d.type == 'post_like' && d.entityType == 'post'
                && nid == 'like_' + d.entityId + '_' + request.auth.uid
                && canSee(uid)
                && exists(/databases/$(database)/documents/activities/$(uid)/items/$(d.entityId)))
              || (d.type == 'post_comment' && d.entityType == 'post'
                && nid.size() >= 6 && nid.size() <= 160 && nid.matches('cmt_.*')
                && canSee(uid)
                && exists(/databases/$(database)/documents/activities/$(uid)/items/$(d.entityId)))
            );
        }
        allow read: if me(uid);
        allow create: if validNotif(request.resource.data);
        allow update: if (me(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            && request.resource.data.read is bool)
          || (signedIn() && resource.data.actorId == request.auth.uid && validNotif(request.resource.data));
        allow delete: if me(uid) || (signedIn() && resource.data.actorId == request.auth.uid);
      }
    }

    // Codigos de amigo: so se le um codigo conhecido (nao se lista) e nao se toma o de outra pessoa.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() >= 4 && code.size() <= 8
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && code.size() >= 4 && code.size() <= 8
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Pedidos de amizade: id = destinatario_remetente (um por par), remetente verificado.
    match /requests/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'status', 't'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.t is number;
      allow read, delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
    }

    // Atividades partilhadas: so o dono escreve; so amigos (que o dono aceitou) leem.
    match /activities/{uid}/items/{aid} {
      allow read: if signedIn() && (request.auth.uid == uid
        || exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
      allow create, update: if me(uid)
        && request.resource.data.keys().hasOnly(['title', 'type', 'date', 'dist', 'dur', 'elev', 'r', 'eff', 'desc'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.type is string && request.resource.data.type.size() <= 40
        && request.resource.data.date is number && request.resource.data.date > 0 && request.resource.data.date <= request.time.toMillis() + 86400000
        && request.resource.data.dist is number && request.resource.data.dist >= 0 && request.resource.data.dist <= 10000000
        && request.resource.data.dur is number && request.resource.data.dur >= 0 && request.resource.data.dur <= 8640000
        && request.resource.data.elev is number && request.resource.data.elev >= -10000 && request.resource.data.elev <= 100000
        && request.resource.data.eff is number && request.resource.data.eff >= 0 && request.resource.data.eff <= 10
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 300
        && request.resource.data.r is list && request.resource.data.r.size() <= 170;
      allow delete: if me(uid);

      // Gostos: um por amigo (o id do documento e o id de quem deu gosto).
      match /kudos/{kid} {
        allow read: if canSee(uid);
        allow create, update: if canSee(uid) && kid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 't'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.t is number;
        allow delete: if signedIn() && (kid == request.auth.uid || request.auth.uid == uid);
      }

      // Comentarios: o autor escreve; o autor ou o dono da atividade apagam.
      match /comments/{cid} {
        allow read: if canSee(uid);
        allow create: if canSee(uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 't'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
          && request.resource.data.t is number;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || request.auth.uid == uid);

        // Likes em comentarios: um por amigo/dono (o id do documento e o uid de quem deu like).
        match /likes/{lid} {
          allow read: if canSee(uid);
          allow create, update: if canSee(uid) && lid == request.auth.uid
            && request.resource.data.keys().hasOnly(['name', 't'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 60
            && request.resource.data.t is number;
          allow delete: if signedIn() && (lid == request.auth.uid || request.auth.uid == uid);
        }
      }
    }
  }
}
